ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Accounts + data (MongoDB Atlas → Connect → Drivers → connection string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=clipforge
# Who may sign up after the first (owner) account: leave empty = anyone,
# set a code = invite only, or CLIPFORGE_SIGNUP=closed
# CLIPFORGE_SIGNUP_CODE=
# Clip storage (Cloudinary dashboard → API environment variable)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Website: each user connects their own accounts in Settings (OAuth)
# PUBLIC_URL=https://clips.example.com        # where people open the dashboard (default: the request URL)
# Google Cloud → Credentials → OAuth client "Web application",
#   redirect URI <PUBLIC_URL>/connect/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Meta app → Instagram → API setup with Instagram login (Business login),
#   OAuth redirect URI <PUBLIC_URL>/connect/instagram/callback  (https required)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Generated automatically on first use — keep it; it decrypts the stored logins
# CLIPFORGE_SECRET_KEY=

# CLI publishing (python -m clipforge publish) — OAuth client (Google Cloud → Credentials → "Desktop app")
YOUTUBE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# written automatically when you click "Connect YouTube"
# YOUTUBE_REFRESH_TOKEN=

# Instagram Reels publishing — Facebook-Login token (EAA…) from an app with
# "Instagram API with Facebook Login"; Instagram must be linked to a Facebook Page.
# Uploads go straight from disk. (Instagram-Login tokens "IGAA…" can only post from public links.)
INSTAGRAM_ACCESS_TOKEN=EAA-your-token
# found and written automatically from the token; set INSTAGRAM_USERNAME to pick one of several
# INSTAGRAM_USER_ID=
# INSTAGRAM_USERNAME=

# optional
# CLIPFORGE_WHISPER=large-v3
HF_HUB_DISABLE_SYMLINKS_WARNING=1
