ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# YouTube Shorts publishing — OAuth client (Google Cloud → Credentials → "Desktop app")
YOUTUBE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# written automatically when you click "Connect YouTube"
# YOUTUBE_REFRESH_TOKEN=

# Instagram Reels publishing — Facebook-Login token (EAA…) from an app with
# "Instagram API with Facebook Login"; Instagram must be linked to a Facebook Page.
# Uploads go straight from disk. (Instagram-Login tokens "IGAA…" can only post from public links.)
INSTAGRAM_ACCESS_TOKEN=EAA-your-token
# found and written automatically from the token; set INSTAGRAM_USERNAME to pick one of several
# INSTAGRAM_USER_ID=
# INSTAGRAM_USERNAME=

# optional
# CLIPFORGE_WHISPER=large-v3
HF_HUB_DISABLE_SYMLINKS_WARNING=1
